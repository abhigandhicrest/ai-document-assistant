APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8001

ALLOWED_ORIGINS=

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10

CHUNK_SIZE=800
CHUNK_OVERLAP=120

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIR=storage/chroma
METADATA_DB_PATH=storage/metadata/documents.db

# Folder where Laravel stores private PDFs. Relative paths stay inside python-ai/.
LARAVEL_STORAGE_DIR=../storage/app/private
TOP_K=4

# ollama: local model server. No API key. Run `ollama pull llama3.2` first.
# openai: hosted API. Set LLM_API_KEY and LLM_BASE_URL=https://api.openai.com/v1.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_SECONDS=45

# Leave empty for local development. Set the same value as Laravel AI_PYTHON_TOKEN
# before exposing this API beyond your machine.
API_TOKEN=
